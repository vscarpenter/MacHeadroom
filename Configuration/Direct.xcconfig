// Direct-download (Developer ID) overlay. Applied on top of the selected
// Release configuration via `xcodebuild -xcconfig`; the Release target's
// Shared.xcconfig remains the single source for version and bundle metadata.
// No sandbox: the popover quit feature exists only here.

ENABLE_APP_SANDBOX = NO
CODE_SIGN_ENTITLEMENTS = MacHeadroom/MacHeadroomDirect.entitlements
