// Direct-download (Developer ID) overlay. Applied on top of the selected
// Release configuration via `xcodebuild -xcconfig`. The App Store bundle ID
// remains stable for updates; this separate identifier lets both editions
// live on the same Mac without replacing one another.
// No sandbox: the popover quit feature exists only here.

APP_DISPLAY_NAME = System Headroom Direct
PRODUCT_NAME = $(APP_DISPLAY_NAME)
PRODUCT_BUNDLE_IDENTIFIER = com.vinnycarpenter.SystemHeadroom.Direct
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)
ENABLE_APP_SANDBOX = NO
CODE_SIGN_ENTITLEMENTS = SystemHeadroom/SystemHeadroomDirect.entitlements

// Sparkle exists only in this flavor. DIRECT_EDITION gates the Swift
// updater wrapper; DIRECT_EDITION_BUILD gates the embed build phase
// (Scripts/embed-sparkle.sh). The Sparkle Info.plist keys ride the
// InfoDirect.plist merge below — INFOPLIST_KEY_ passthrough drops unknown
// keys, and the shared Info.plist must never carry Sparkle keys into the
// App Store flavor.
INFOPLIST_FILE = SystemHeadroom/InfoDirect.plist
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DIRECT_EDITION
DIRECT_EDITION_BUILD = YES
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/Vendor/Sparkle
OTHER_LDFLAGS = $(inherited) -framework Sparkle
// Filled in once generate_keys has run on the release machine; blank keys
// are tolerated by dev builds and rejected by release-direct.sh.
DIRECT_SPARKLE_PUBLIC_ED_KEY = zM7z7Yzk7eLMWDDsD/q44/9cWUXvR3VgnoC38wzta30=
// The embed phase copies a framework tree, which Xcode's user-script
// sandbox cannot express as inputPaths. This flavor is the unsandboxed
// one by definition; the App Store build keeps script sandboxing on.
ENABLE_USER_SCRIPT_SANDBOXING = NO
