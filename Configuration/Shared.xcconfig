APP_DISPLAY_NAME = System Headroom

PRODUCT_NAME = $(APP_DISPLAY_NAME)
PRODUCT_MODULE_NAME = SystemHeadroom
// Preserve the established App Store identity so existing installs receive this update.
PRODUCT_BUNDLE_IDENTIFIER = com.vinnycarpenter.MacHeadroom
// Leave blank unless the App Store build has an approved, HTTPS claim service.
// The client treats a missing value as unavailable and makes no network calls.
DIRECT_EDITION_CLAIM_URL =
MARKETING_VERSION = 1.1
CURRENT_PROJECT_VERSION = 12

SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 14.0

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_OBJC_BRIDGING_HEADER = SystemHeadroom/Sampling/PortTableABI.h
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES

ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
CODE_SIGN_ENTITLEMENTS = SystemHeadroom/SystemHeadroom.entitlements
CODE_SIGN_STYLE = Automatic
LM_SKIP_METADATA_EXTRACTION = YES

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)
INFOPLIST_KEY_CFBundleName = $(APP_DISPLAY_NAME)
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
INFOPLIST_FILE = SystemHeadroom/Info.plist
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_NSHumanReadableCopyright = Copyright © 2026 Vinny Carpenter

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
